# Example only. Do not put a real token in this file.
HOME_ASSISTANT_URL=http://192.168.1.127:8123
HOME_ASSISTANT_TOKEN_FILE=systemd-credential:home-assistant.token
# * means every entity state returned by GET /api/states. Attributes are not exposed.
HOME_ASSISTANT_ALLOWED_ENTITIES=*
HOME_ASSISTANT_MODE=read_all
