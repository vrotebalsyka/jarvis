# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler exact private Alice webhook health and bounded recovery
After=network-online.target tailscaled.service home-butler-alice-skill.service home-butler-alice-tunnel.service
Wants=network-online.target tailscaled.service home-butler-alice-skill.service home-butler-alice-tunnel.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/home-butler
Environment=HOME=/root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/alice_skill_health.py --recover
LoadCredential=alice-skill-secret:/root/Jarvis/home-butler/secrets/alice-skill-secret
LoadCredential=alice-skill-secret-next:/root/Jarvis/home-butler/secrets/alice-skill-secret-next
LoadCredential=alice-skill-id:/root/Jarvis/home-butler/secrets/alice-skill-id
LoadCredential=alice-owner-ids:/root/Jarvis/home-butler/secrets/alice-owner-ids
RuntimeDirectory=home-butler-alice-health
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=55
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/home-butler-alice-health
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
StandardOutput=journal
StandardError=journal
