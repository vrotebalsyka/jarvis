# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Probe the private Alice path every minute

[Timer]
OnBootSec=30s
OnUnitActiveSec=1min
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=home-butler-alice-health.service

[Install]
WantedBy=timers.target
