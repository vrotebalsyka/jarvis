# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler commit an authenticated Alice Webhook rotation
After=home-butler-alice-skill.service
Requires=home-butler-alice-skill.service
ConditionPathExists=/home/homebutler/.local/state/home-butler/alice/webhook-next-used
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/rotate-alice-webhook.py --commit
Restart=on-failure
RestartSec=15
TimeoutStartSec=210
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/Jarvis/home-butler/secrets
ReadWritePaths=/home/homebutler/.local/state/home-butler/alice
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
TasksMax=16
StandardOutput=journal
StandardError=journal
