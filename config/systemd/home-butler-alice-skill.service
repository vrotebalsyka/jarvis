# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler private Yandex Alice full-dialog gateway
After=network-online.target ollama.service
Wants=network-online.target ollama.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_ALICE_PORT=8765
Environment=HOME_BUTLER_ALICE_CLAIM_FILE=/home/homebutler/.local/state/home-butler/alice/claim.json
Environment=HOME_BUTLER_ALICE_ROTATION_MARKER=/home/homebutler/.local/state/home-butler/alice/webhook-next-used
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/alice_skill_gateway.py
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
LoadCredential=alice-skill-secret:/root/Jarvis/home-butler/secrets/alice-skill-secret
LoadCredential=alice-skill-secret-next:/root/Jarvis/home-butler/secrets/alice-skill-secret-next
LoadCredential=alice-skill-id:/root/Jarvis/home-butler/secrets/alice-skill-id
LoadCredential=alice-owner-ids:/root/Jarvis/home-butler/secrets/alice-owner-ids
Restart=on-failure
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler/alice
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.1.127/32
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
