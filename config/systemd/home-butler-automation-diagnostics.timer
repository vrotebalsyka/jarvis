# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Inspect Home Assistant automation failures every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=55s
RandomizedDelaySec=3
AccuracySec=1s
Persistent=true
Unit=home-butler-automation-diagnostics.service

[Install]
WantedBy=timers.target
