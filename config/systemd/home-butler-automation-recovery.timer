# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Check for bounded automation recovery every minute

[Timer]
OnBootSec=3min
OnUnitActiveSec=1min
RandomizedDelaySec=4
AccuracySec=1s
Persistent=true
Unit=home-butler-automation-recovery.service

[Install]
WantedBy=timers.target
