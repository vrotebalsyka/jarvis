# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler daily 13:00 report through Alice station
After=network-online.target home-butler-inventory.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_DAILY_REPORT_STATUS=/home/homebutler/.local/state/home-butler/daily-report-status.json
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/daily_voice_report.py --live
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.1.127/32
TasksMax=32
StandardOutput=journal
StandardError=journal
