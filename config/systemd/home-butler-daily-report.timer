# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Run the Home Butler persistent scheduler frequently

[Timer]
OnBootSec=30s
OnUnitActiveSec=15s
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=home-butler-daily-report.service

[Install]
WantedBy=timers.target
