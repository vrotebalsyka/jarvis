# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Speak the Home Butler status report every day at exactly 13:00

[Timer]
OnCalendar=*-*-* 13:00:00 Asia/Yekaterinburg
OnCalendar=*-*-* 13:05:00 Asia/Yekaterinburg
OnCalendar=*-*-* 13:10:00 Asia/Yekaterinburg
OnCalendar=*-*-* 13:15:00 Asia/Yekaterinburg
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=home-butler-daily-report.service

[Install]
WantedBy=timers.target
