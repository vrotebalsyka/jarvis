# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Assess every Home Assistant device and integration every ten seconds

[Timer]
OnBootSec=3min
OnUnitActiveSec=10s
RandomizedDelaySec=0
AccuracySec=1s
Persistent=true
Unit=home-butler-device-health.service

[Install]
WantedBy=timers.target
