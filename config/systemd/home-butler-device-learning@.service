# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler read-only learning for one physical HA device
After=network-online.target home-butler-inventory.service
Wants=network-online.target home-butler-inventory.service

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_INCIDENT_STATE_DIR=/home/homebutler/.local/state/home-butler/incidents
Environment=HOME_BUTLER_MODEL_WORKSPACE=/home/homebutler/.local/share/home-butler/model-workspace
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/device_learning.py --physical-device-id %i
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
Restart=no
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/share/home-butler/model-workspace
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.1.127/32
TasksMax=64
StandardOutput=journal
StandardError=journal
