# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler read-only new-device onboarding queue refresh
After=home-butler-ha-device-knowledge.service
Wants=home-butler-ha-device-knowledge.service

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/device_onboarding.py
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=16
StandardOutput=journal
StandardError=journal

