# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Check validated HA diagnostic alerts every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=home-butler-diagnostic-monitor.service

[Install]
WantedBy=timers.target
