# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler local and public Alice dialogue qualification
After=network-online.target home-butler-local-chat.service home-butler-alice-skill.service home-butler-alice-tunnel.service
Wants=network-online.target home-butler-local-chat.service home-butler-alice-skill.service home-butler-alice-tunnel.service
StartLimitIntervalSec=1200
StartLimitBurst=8

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/dialogue_qualification.py
LoadCredential=alice-skill-secret:/root/Jarvis/home-butler/secrets/alice-skill-secret
LoadCredential=alice-skill-secret-next:/root/Jarvis/home-butler/secrets/alice-skill-secret-next
LoadCredential=alice-skill-id:/root/Jarvis/home-butler/secrets/alice-skill-id
LoadCredential=alice-owner-ids:/root/Jarvis/home-butler/secrets/alice-owner-ids
Restart=on-failure
RestartSec=60
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64
StandardOutput=journal
StandardError=journal
