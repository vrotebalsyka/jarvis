# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler read-only Home Assistant device knowledge refresh
After=home-butler-inventory.service
Wants=home-butler-inventory.service

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_INCIDENT_STATE_DIR=/home/homebutler/.local/state/home-butler/incidents
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/ha_device_knowledge.py
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=16
StandardOutput=journal
StandardError=journal

