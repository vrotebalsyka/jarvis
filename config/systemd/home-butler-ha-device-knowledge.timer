# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Refresh Home Butler Home Assistant device knowledge

[Timer]
OnBootSec=4min
OnUnitActiveSec=1min
RandomizedDelaySec=10s
AccuracySec=1s
Persistent=true
Unit=home-butler-ha-device-knowledge.service

[Install]
WantedBy=timers.target
