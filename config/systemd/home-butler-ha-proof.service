# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler verified read-only Home Assistant model proof
After=network-online.target home-butler.service
Wants=network-online.target

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/home-butler/scripts/model_ha_proof.py --require-gpu
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.1.127/32
TasksMax=64
StandardOutput=journal
StandardError=journal
