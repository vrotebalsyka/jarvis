# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Check for all confirmed Home Butler device incidents every ten seconds

[Timer]
OnBootSec=20s
OnUnitActiveSec=10s
RandomizedDelaySec=2
AccuracySec=1s
Persistent=true
Unit=home-butler-incident-notifier.service

[Install]
WantedBy=timers.target
