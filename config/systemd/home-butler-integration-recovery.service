# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler profile-bound integration recovery planner and executor
After=network-online.target home-butler-device-health.service home-butler-inventory.service
Wants=network-online.target home-butler.service

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_INCIDENT_STATE_DIR=/home/homebutler/.local/state/home-butler/incidents
Environment=HOME_BUTLER_INTEGRATION_RECOVERY_MODE=live
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/integration_recovery.py
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler/incidents
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
TasksMax=32
StandardOutput=journal
StandardError=journal
