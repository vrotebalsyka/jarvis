[Unit]
Description=Refresh Home Butler private Home Assistant inventory

[Timer]
OnBootSec=3min
OnUnitActiveSec=30s
RandomizedDelaySec=15
AccuracySec=1s
Persistent=true
Unit=home-butler-inventory.service

[Install]
WantedBy=timers.target
