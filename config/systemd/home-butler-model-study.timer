# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Refresh Home Butler read-only model study daily

[Timer]
OnBootSec=15min
OnCalendar=*-*-* 12:15:00 Asia/Yekaterinburg
AccuracySec=1min
RandomizedDelaySec=30s
Persistent=true
Unit=home-butler-model-study.service

[Install]
WantedBy=timers.target
