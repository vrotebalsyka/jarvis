# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler bounded Home Assistant device recovery
After=network-online.target home-butler-incident-monitor.service home-butler-inventory.service
Wants=network-online.target home-butler-incident-monitor.service

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME_BUTLER_INCIDENT_STATE_DIR=/home/homebutler/.local/state/home-butler/incidents
Environment=HOME_BUTLER_RECOVERY_MODE=live
Environment=HOME_BUTLER_XIAOMI_RECOVERY=disabled
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/home_assistant_recovery.py
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.local/state/home-butler/incidents
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=192.168.1.127/32
TasksMax=32
StandardOutput=journal
StandardError=journal
