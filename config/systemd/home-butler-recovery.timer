# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Check for bounded Home Butler recovery work every minute

[Timer]
OnBootSec=4min
OnUnitActiveSec=1min
RandomizedDelaySec=5
AccuracySec=1s
Persistent=true
Unit=home-butler-recovery.service

[Install]
WantedBy=timers.target
