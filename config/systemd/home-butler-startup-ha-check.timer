# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Run the initial Home Butler HA model check after WSL starts

[Timer]
OnBootSec=90s
RandomizedDelaySec=15
AccuracySec=1s
Persistent=true
Unit=home-butler-startup-ha-check.service

[Install]
WantedBy=timers.target
