# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Run the verified Home Butler self-check after WSL starts

[Timer]
OnBootSec=90s
RandomizedDelaySec=10s
AccuracySec=1s
Persistent=true
Unit=home-butler-startup-self-check.service

[Install]
WantedBy=timers.target
