# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler one verified startup HA and Alice status announcement
After=network-online.target home-butler-incident-monitor.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/home-butler/scripts/startup_voice_status.py
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
LoadCredential=alice-skill-secret:/root/Jarvis/home-butler/secrets/alice-skill-secret
LoadCredential=alice-skill-secret-next:/root/Jarvis/home-butler/secrets/alice-skill-secret-next
LoadCredential=alice-skill-id:/root/Jarvis/home-butler/secrets/alice-skill-id
LoadCredential=alice-owner-ids:/root/Jarvis/home-butler/secrets/alice-owner-ids
RuntimeDirectory=home-butler-startup-voice
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/home-butler-startup-voice
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
StandardOutput=journal
StandardError=journal
