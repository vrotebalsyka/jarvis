# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Inspect sanitized Home Assistant system errors every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
RandomizedDelaySec=3
AccuracySec=1s
Persistent=true
Unit=home-butler-system-log-diagnostics.service

[Install]
WantedBy=timers.target
