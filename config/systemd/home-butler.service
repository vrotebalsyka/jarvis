# Managed by /root/Jarvis/home-butler/scripts/install-home-butler-service.sh
[Unit]
Description=Home Butler Hermes Gateway
After=network-online.target ollama.service
Wants=network-online.target ollama.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=homebutler
Group=homebutler
WorkingDirectory=/opt/home-butler
Environment=HOME=/home/homebutler
Environment=HERMES_HOME=/home/homebutler/.hermes
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 /opt/home-butler/scripts/ollama_endpoint.py --prefer-primary-seconds 45 --wait-seconds 60
ExecStart=/opt/home-butler/scripts/run-hermes-gateway.sh
LoadCredential=home-assistant.token:/root/Jarvis/home-butler/secrets/home-assistant.token
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/homebutler/.hermes
BindReadOnlyPaths=/opt/home-butler/hermes/config.yaml:/home/homebutler/.hermes/config.yaml
BindReadOnlyPaths=/opt/home-butler/hermes/SOUL.md:/home/homebutler/.hermes/SOUL.md
BindReadOnlyPaths=/opt/home-butler/hermes/.no-bundled-skills:/home/homebutler/.hermes/.no-bundled-skills
BindReadOnlyPaths=/opt/home-butler/skills:/home/homebutler/.hermes/skills
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.1.127/32
TasksMax=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
